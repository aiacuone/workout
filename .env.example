# Leave unset to use the embedded Postgres (PGlite) stored in PGLITE_DIR.
# DATABASE_URL=postgres://user:password@localhost:5432/workout

# Directory for the embedded database when DATABASE_URL is not set.
PGLITE_DIR=./data/pglite

# Required behind a reverse proxy with adapter-node, e.g. https://workout.example.com
# ORIGIN=https://workout.example.com

# Google OAuth web client. Authorized redirect URI: {ORIGIN}/login/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Comma-separated Google accounts allowed to sign in.
# ALLOWED_EMAILS=you@gmail.com,friend@gmail.com

# Optional Google Analytics 4 measurement ID for public preview pages only.
# PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
